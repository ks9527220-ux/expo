// App.js
import React, { useState, useRef } from "react";
import {
  View,
  Text,
  SafeAreaView,
  TouchableOpacity,
  FlatList,
  Dimensions,
  StyleSheet,
  Animated,
  Easing,
} from "react-native";

const { width } = Dimensions.get("window");
const BALL_SIZE = Math.round(width / 4.5);

const DEFAULT_PRIZES = [
  "10 نقاط",
  "قلم مجاني",
  "خصم 20%",
  "لا شيء 😅",
  "قهوة مجانية",
  "جائزة كبرى!",
  "هدية مفاجئة",
  "اشتراك شهر",
];

export default function App() {
  // عدد الطابات (=طول المصفوفة)
  const [prizes] = useState(DEFAULT_PRIZES);
  const n = prizes.length;

  const [animating, setAnimating] = useState(false);
  const [highlightIndex, setHighlightIndex] = useState(null);
  const [revealedIndex, setRevealedIndex] = useState(null);
  const scaleAnims = useRef(prizes.map(() => new Animated.Value(1))).current;

  // يطلق "دوران الطابات" ثم يختار وينفتح
  const startSpin = async () => {
    if (animating) return;
    setAnimating(true);
    setRevealedIndex(null);

    // محاكاة دوران: نسلّط ضوء على طابة متغيرة بسرعة ثم تبطأ
    const steps = 28; // مزيد => دوران أطول
    const baseDelay = 50;
    const slowdown = 6; // كل زيادة هنا تبطئ النهاية
    let current = Math.floor(Math.random() * n);

    for (let i = 0; i < steps; i++) {
      // حدد المؤشر التالي
      current = (current + 1 + Math.floor(Math.random() * 2)) % n;
      setHighlightIndex(current);

      // زمن بين خطوات يتزايد تدريجياً ليحاكي التباطؤ
      const delay = baseDelay + Math.round((i / steps) * 400) + i * slowdown;
      await wait(delay);
    }

    // اختر فائز نهائي (يمكنك استخدام current أو تصنيف آخر)
    const winner = current;
    setRevealAnimation(winner);
    setRevealedIndex(winner);
    setAnimating(false);
  };

  const setRevealAnimation = (idx) => {
    // نبض وصعود الطابة الفائزة
    Animated.sequence([
      Animated.timing(scaleAnims[idx], {
        toValue: 1.25,
        duration: 220,
        easing: Easing.out(Easing.quad),
        useNativeDriver: true,
      }),
      Animated.timing(scaleAnims[idx], {
        toValue: 0.9,
        duration: 140,
        easing: Easing.in(Easing.quad),
        useNativeDriver: true,
      }),
      Animated.timing(scaleAnims[idx], {
        toValue: 1,
        duration: 180,
        easing: Easing.out(Easing.quad),
        useNativeDriver: true,
      }),
    ]).start();
  };

  return (
    <SafeAreaView style={styles.container}>
      <Text style={styles.title}>لعبة الطابات — افتح واعرف جائزتك!</Text>

      <View style={styles.gridWrap}>
        <FlatList
          data={prizes}
          keyExtractor={(_, i) => String(i)}
          numColumns={2}
          scrollEnabled={false}
          renderItem={({ item, index }) => {
            const isHighlighted = index === highlightIndex;
            const isRevealed = index === revealedIndex;
            const scale = scaleAnims[index];

            return (
              <View style={styles.cell}>
                <Animated.View
                  style={[
                    styles.ball,
                    isHighlighted ? styles.ballHighlighted : null,
                    { transform: [{ scale }] },
                  ]}
                >
                  {!isRevealed ? (
                    <Text style={styles.ballText}>?</Text>
                  ) : (
                    <Text style={styles.prizeText}>{item}</Text>
                  )}
                </Animated.View>
              </View>
            );
          }}
        />
      </View>

      <TouchableOpacity
        onPress={startSpin}
        activeOpacity={0.8}
        style={[styles.btn, animating ? styles.btnDisabled : null]}
        disabled={animating}
      >
        <Text style={styles.btnText}>
          {animating ? "يتم الدوران..." : "دور الطابات!"}
        </Text>
      </TouchableOpacity>

      <View style={styles.footer}>
        <Text style={styles.hint}>
          ملاحظة: عدل قائمة الجوائز في المتغير DEFAULT_PRIZES داخل App.js
        </Text>
        {revealedIndex !== null && (
          <Text style={styles.result}>
            الجائزة: {prizes[revealedIndex]}
          </Text>
        )}
      </View>
    </SafeAreaView>
  );
}

function wait(ms) {
  return new Promise((res) => setTimeout(res, ms));
}

const styles = StyleSheet.create({
  container: { flex: 1, alignItems: "center", paddingTop: 30 },
  title: { fontSize: 20, fontWeight: "700", marginBottom: 12 },
  gridWrap: {
    width: "90%",
    aspectRatio: 1.0,
    marginBottom: 18,
  },
  cell: {
    flex: 1,
    alignItems: "center",
    justifyContent: "center",
    padding: 8,
  },
  ball: {
    width: BALL_SIZE,
    height: BALL_SIZE,
    borderRadius: BALL_SIZE / 2,
    backgroundColor: "#ffcc00",
    alignItems: "center",
    justifyContent: "center",
    elevation: 4,
    shadowColor: "#000",
    shadowOpacity: 0.15,
    shadowOffset: { width: 0, height: 3 },
    shadowRadius: 4,
  },
  ballHighlighted: {
    backgroundColor: "#ff8c42",
    transform: [{ scale: 1.08 }],
  },
  ballText: { fontSize: 28, fontWeight: "800", color: "#fff" },
  prizeText: { fontSize: 16, fontWeight: "700", color: "#3a2b00", textAlign: "center", paddingHorizontal: 6 },
  btn: {
    backgroundColor: "#2b8aef",
    paddingHorizontal: 28,
    paddingVertical: 12,
    borderRadius: 14,
  },
  btnDisabled: { backgroundColor: "#99c4f5" },
  btnText: { color: "#fff", fontSize: 18, fontWeight: "700" },
  footer: { marginTop: 18, alignItems: "center", width: "90%" },
  hint: { color: "#666", textAlign: "center", marginBottom: 8 },
  result: { marginTop: 6, fontSize: 18, fontWeight: "700" },
});
